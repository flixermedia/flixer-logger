{
  "openapi": "3.1.0",
  "info": {
    "title": "Flixer Logger",
    "version": "0.1.0",
    "description": "Experimental API. Tenant identity comes from the bearer credential. Remote connections require TLS. API paths are not versioned; events carry schema_version. Errors are JSON objects with an error string. Authentication failures return 401. Global capacity and storage failures return 503; tenant capacity and rate limits return 429, usually with Retry-After. Requests and responses must not be cached."
  },
  "security": [{"bearerAuth": []}],
  "paths": {
    "/api/openapi.json": {
      "get": {"security": [], "summary": "Read this contract", "responses": {"200": {"description": "OpenAPI document", "content": {"application/json": {"schema": {"type": "object"}}}}}}
    },
    "/api/health/live": {
      "get": {"security": [], "summary": "Process liveness", "responses": {"200": {"description": "Process is live", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}}}
    },
    "/api/health/ready": {
      "get": {"security": [], "summary": "Storage readiness", "responses": {"200": {"description": "Storage is ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/status": {
      "get": {"summary": "Deployment activity", "description": "Requires manage scope. Counts are instantaneous and exclude other deployments.", "responses": {"200": {"description": "Tenant status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Status"}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/owner/capacity": {
      "get": {"summary": "Global storage capacity", "description": "Requires an operator-provisioned owner credential; deployment credentials cannot access global metrics. Database usage is Pebble-reported, not total directory usage or a quota.", "responses": {"200": {"description": "Filesystem and Pebble capacity", "content": {"application/json": {"schema": {"type": "object", "required": ["filesystem_total_bytes", "filesystem_available_bytes", "database_bytes", "compaction_debt_bytes", "compactions_in_progress"], "properties": {"filesystem_total_bytes": {"type": "integer", "minimum": 0}, "filesystem_available_bytes": {"type": "integer", "minimum": 0}, "database_bytes": {"type": "integer", "minimum": 0}, "compaction_debt_bytes": {"type": "integer", "minimum": 0}, "compactions_in_progress": {"type": "integer", "minimum": 0}}}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/owner/capacity-policy": {
      "get": {"summary": "Read global ingestion capacity thresholds", "description": "Requires owner scope. Zero disables a threshold.", "responses": {"200": {"description": "Global capacity policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CapacityPolicy"}}}}, "401": {"$ref": "#/components/responses/Error"}}},
      "put": {"summary": "Replace global ingestion capacity thresholds", "description": "Requires owner scope. These best-effort checks are not a hard physical quota; compaction and other processes can consume space after the check.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CapacityPolicy"}}}}, "responses": {"200": {"description": "Updated capacity policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CapacityPolicy"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/owner/credentials": {
      "get": {"summary": "List issued management credentials", "description": "Requires owner scope. Lists metadata only for the specified deployment; bootstrap credentials and tokens are not listed.", "parameters": [{"$ref": "#/components/parameters/DeploymentID"}], "responses": {"200": {"description": "Management credentials", "content": {"application/json": {"schema": {"type": "object", "required": ["credentials"], "properties": {"credentials": {"type": "array", "items": {"$ref": "#/components/schemas/ManagementCredential"}}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "post": {"summary": "Issue a deployment management credential", "description": "Requires owner scope. Token is returned once and must be transferred securely. Expiry must be within one year. Issuance does not establish an automated pairing flow.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["deployment_id", "expires_at"], "properties": {"deployment_id": {"type": "string", "minLength": 1, "maxLength": 128}, "expires_at": {"type": "string", "format": "date-time"}}}}}}, "responses": {"201": {"description": "Credential and one-time token", "content": {"application/json": {"schema": {"type": "object", "required": ["credential", "token"], "properties": {"credential": {"$ref": "#/components/schemas/ManagementCredential"}, "token": {"type": "string"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/owner/credentials/{id}": {
      "delete": {"summary": "Revoke a management credential", "description": "Requires owner scope. This does not revoke ingest or query credentials issued by the management credential.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}, {"$ref": "#/components/parameters/DeploymentID"}], "responses": {"204": {"description": "Revoked"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/owner/pairings": {
      "get": {"summary": "List pending enrollment pairings", "description": "Requires owner scope. Returns unexpired metadata for the selected deployment, without tokens or digests.", "parameters": [{"$ref": "#/components/parameters/DeploymentID"}], "responses": {"200": {"description": "Pending pairings", "content": {"application/json": {"schema": {"type": "object", "required": ["pairings"], "properties": {"pairings": {"type": "array", "items": {"$ref": "#/components/schemas/Pairing"}}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "post": {"summary": "Create a single-use enrollment pairing", "description": "Requires owner scope. Pairing expires within 15 minutes; the management credential expires within one year. The pairing token is returned once and must be transferred securely.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["deployment_id", "expires_at", "management_expiry"], "properties": {"deployment_id": {"type": "string", "minLength": 1, "maxLength": 128}, "expires_at": {"type": "string", "format": "date-time"}, "management_expiry": {"type": "string", "format": "date-time"}}}}}}, "responses": {"201": {"description": "Pairing metadata and one-time token", "content": {"application/json": {"schema": {"type": "object", "required": ["pairing", "token"], "properties": {"pairing": {"$ref": "#/components/schemas/Pairing"}, "token": {"type": "string"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/owner/pairings/{id}": {
      "delete": {"summary": "Revoke a pending pairing", "description": "Requires owner scope and the matching deployment ID.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}, {"$ref": "#/components/parameters/DeploymentID"}], "responses": {"204": {"description": "Revoked"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/logger/pairings/redeem": {
      "post": {"security": [], "summary": "Redeem an enrollment pairing", "description": "The one-time pairing token authenticates this request. A successful response returns a deployment-bound management token once; consumption and issuance are committed atomically. If the response is lost, create a new pairing. Requires TLS outside loopback.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["token"], "properties": {"token": {"type": "string"}}}}}}, "responses": {"201": {"description": "Deployment management credential and one-time token", "content": {"application/json": {"schema": {"type": "object", "required": ["deployment_id", "credential", "token"], "properties": {"deployment_id": {"type": "string"}, "credential": {"$ref": "#/components/schemas/ManagementCredential"}, "token": {"type": "string"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/batch": {
      "post": {
        "summary": "Ingest events", "description": "Requires ingest scope. JSON or gzip; compressed and expanded bodies are each limited to 2 MiB. Duplicate event IDs are accepted but not inserted. Server assigns deployment and ingestion time. Event and index writes are atomic. Clients may send X-Flixer-Log-Schema: 1; omitted headers are accepted for backward compatibility. Unsupported or repeated versions return 409 before storing events. Responses advertise the supported schema in the same header.",
        "parameters": [{"name": "Content-Encoding", "in": "header", "schema": {"type": "string", "enum": ["identity", "gzip"]}}, {"name": "X-Flixer-Log-Schema", "in": "header", "schema": {"type": "string", "enum": ["1"]}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["events"], "additionalProperties": false, "properties": {"events": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/components/schemas/Event"}}}}}}},
        "responses": {"200": {"description": "Accepted and newly inserted event counts", "content": {"application/json": {"schema": {"type": "object", "required": ["accepted", "inserted"], "properties": {"accepted": {"type": "integer"}, "inserted": {"type": "integer"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "403": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "415": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}
      }
    },
    "/api/logs": {
      "get": {"summary": "Recent or single-index events", "description": "Requires query scope. Without field, returns recent events without pagination. With field and value, returns newest-first index pages; cursor must be reused with the same field and value.",
        "parameters": [{"$ref": "#/components/parameters/Limit1000"}, {"name": "field", "in": "query", "schema": {"type": "string", "enum": ["app", "instance", "level", "source", "event", "trace", "request", "task", "text"]}}, {"name": "value", "in": "query", "schema": {"type": "string"}}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {"200": {"$ref": "#/components/responses/EventPage"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/search": {
      "post": {"summary": "Bounded historical search", "description": "Requires query scope. Bounds use ingestion time and may span at most 31 days. Up to 10,000 candidates and five seconds are allowed; 422 means the candidate budget was exceeded. task_queue requires task and filters fields.task_queue after indexed task lookup. Cursors are bound to deployment, filters, order and time window. follow requires oldest order and returns a cursor after every non-empty page, including the last currently available page; on empty pages retain the previous cursor and poll later. Optional projection affects response fields only and may be changed between pages.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Search"}}}},
        "responses": {"200": {"description": "Full or projected events in the selected order", "content": {"application/json": {"schema": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "items": {"$ref": "#/components/schemas/ProjectedEvent"}}, "next_cursor": {"type": "string"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/trace/{trace_id}": {
      "get": {"summary": "Find a trace", "description": "Requires query scope; returns newest-first pages from the trace index.",
        "parameters": [{"name": "trace_id", "in": "path", "required": true, "schema": {"type": "string"}}, {"$ref": "#/components/parameters/Limit1000"}, {"$ref": "#/components/parameters/Cursor"}],
        "responses": {"200": {"$ref": "#/components/responses/EventPage"}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/stats": {
      "get": {"summary": "Minute-level severity counts", "description": "Requires query scope. UTC bounds must be minute-aligned and no more than 31 days apart; empty minutes are omitted.",
        "parameters": [{"$ref": "#/components/parameters/Start"}, {"$ref": "#/components/parameters/End"}],
        "responses": {"200": {"description": "Sparse minute buckets", "content": {"application/json": {"schema": {"type": "object", "required": ["buckets"], "properties": {"buckets": {"type": "array", "items": {"type": "object", "required": ["start", "counts"], "properties": {"start": {"type": "string", "format": "date-time"}, "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}}}}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/sources": {
      "get": {"summary": "Counts by application and source", "description": "Requires query scope. Minute-aligned UTC bounds may span at most 31 days. More than 100,000 minute entries or 1,000 distinct groups returns 422.",
        "parameters": [{"$ref": "#/components/parameters/Start"}, {"$ref": "#/components/parameters/End"}],
        "responses": {"200": {"description": "Source totals", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SourceTotals"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/errors": {
      "get": {"summary": "Group errors", "description": "Requires query scope. Groups by exact app, source, error type, code and message. Queries exceeding 10,000 events or 1,000 groups return 422.",
        "parameters": [{"$ref": "#/components/parameters/Start"}, {"$ref": "#/components/parameters/End"}],
        "responses": {"200": {"description": "Error groups", "content": {"application/json": {"schema": {"type": "object", "required": ["groups"], "properties": {"groups": {"type": "array", "items": {"$ref": "#/components/schemas/ErrorGroup"}}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "422": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Retry"}}}
    },
    "/api/logs/stream": {
      "get": {"summary": "Live events with bounded replay", "description": "Requires query scope. task_queue requires task and matches the string fields.task_queue. At most 10 streams per deployment and 100 globally. Each event has an SSE id. Send the last processed id in Last-Event-ID. Up to 1,000 later events and 8 MiB may be replayed in five seconds; 410 requires historical recovery. Replay limits include events excluded by filters. A slow subscriber receives an overflow event and disconnects. No replay is possible before the first event.",
        "parameters": [
          {"name": "Last-Event-ID", "in": "header", "schema": {"type": "string"}},
          {"$ref": "#/components/parameters/App"}, {"$ref": "#/components/parameters/Instance"}, {"$ref": "#/components/parameters/Level"}, {"$ref": "#/components/parameters/Source"}, {"$ref": "#/components/parameters/EventCode"}, {"$ref": "#/components/parameters/Trace"}, {"$ref": "#/components/parameters/Request"}, {"$ref": "#/components/parameters/Task"}, {"$ref": "#/components/parameters/TaskQueue"}
        ],
        "responses": {"200": {"description": "SSE frames: log events and overflow notifications", "content": {"text/event-stream": {"schema": {"type": "string"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "410": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Retry"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/logger/retention": {
      "get": {"summary": "Read retention policy", "description": "Requires manage scope. An unset policy returns disabled and zero days.", "responses": {"200": {"description": "Retention policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Retention"}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "put": {"summary": "Set retention policy", "description": "Requires manage scope. Deletion uses ingestion time and physical disk reclamation may be delayed.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RetentionUpdate"}}}}, "responses": {"200": {"description": "Saved policy", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Retention"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/logger/ingestion-policy": {
      "get": {"summary": "Read ingestion rate limits", "description": "Requires manage scope.", "responses": {"200": {"description": "Deployment rate limits", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IngestionPolicy"}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "put": {"summary": "Set ingestion rate limits", "description": "Requires manage scope. Optional per-credential and per-service limits apply in addition to the deployment limit; each pair must be specified together. Enabling per-service limits rejects unbound credentials with 403. Omitting a pair disables it, including when an older client replaces the policy. Token bucket state is in memory and restarts full.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IngestionPolicy"}}}}, "responses": {"200": {"description": "Saved limits", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IngestionPolicy"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/logger/quota": {
      "get": {"summary": "Read logical event quota", "description": "Requires manage scope. Used bytes count serialized retained event bodies, not physical storage or indexes.", "responses": {"200": {"description": "Quota and current usage", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Quota"}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "put": {"summary": "Set logical event quota", "description": "Requires manage scope. Zero means unlimited. Over-quota batches return 429 and may be dropped by producers.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["max_bytes"], "additionalProperties": false, "properties": {"max_bytes": {"type": "integer", "minimum": 0, "maximum": 1125899906842624}}}}}}, "responses": {"200": {"description": "Quota and current usage", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Quota"}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/logger/credentials": {
      "get": {"summary": "List issued credentials", "description": "Requires manage scope. Management credentials, bootstrap credentials and token values are not listed.", "responses": {"200": {"description": "Credential metadata", "content": {"application/json": {"schema": {"type": "object", "required": ["credentials"], "properties": {"credentials": {"type": "array", "items": {"$ref": "#/components/schemas/Credential"}}}}}}}, "401": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}},
      "post": {"summary": "Issue an ingest or query credential", "description": "Requires manage scope. The token is returned only once. Maximum lifetime is one year; protect the response. Ingest credentials may optionally be bound to one application; mismatched batches return 403 without storing events. Omitted app remains unrestricted for compatibility.", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["scope", "expires_at"], "additionalProperties": false, "properties": {"scope": {"type": "string", "enum": ["ingest", "query"]}, "app": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "expires_at": {"type": "string", "format": "date-time"}}}}}}, "responses": {"201": {"description": "Credential and one-time token", "content": {"application/json": {"schema": {"type": "object", "required": ["credential", "token"], "properties": {"credential": {"$ref": "#/components/schemas/Credential"}, "token": {"type": "string"}}}}}}, "400": {"$ref": "#/components/responses/Error"}, "401": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/api/logger/credentials/{id}": {
      "delete": {"summary": "Revoke an issued credential", "description": "Requires manage scope. Only issued ingest or query credentials in the caller's deployment can be revoked.", "parameters": [{"name": "id", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9a-f]{32}$"}}], "responses": {"204": {"description": "Revoked"}, "401": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "parameters": {
      "Limit1000": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 100}},
      "Cursor": {"name": "cursor", "in": "query", "schema": {"type": "string"}},
      "Start": {"name": "start", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}},
      "End": {"name": "end", "in": "query", "required": true, "schema": {"type": "string", "format": "date-time"}},
      "DeploymentID": {"name": "deployment_id", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 128}},
      "App": {"name": "app", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "Instance": {"name": "instance", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "Level": {"name": "level", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "Source": {"name": "source", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "EventCode": {"name": "event", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "Trace": {"name": "trace", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "Request": {"name": "request", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "Task": {"name": "task", "in": "query", "schema": {"type": "string", "maxLength": 1024}},
      "TaskQueue": {"name": "task_queue", "in": "query", "description": "Requires task; matches fields.task_queue.", "schema": {"type": "string", "maxLength": 1024}}
    },
    "responses": {
      "Error": {"description": "Request failed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "Retry": {"description": "Capacity or rate limit", "headers": {"Retry-After": {"schema": {"type": "string"}}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
      "EventPage": {"description": "Newest-first events; an empty or omitted cursor means no further page", "content": {"application/json": {"schema": {"type": "object", "required": ["events"], "properties": {"events": {"type": "array", "items": {"$ref": "#/components/schemas/Event"}}, "next_cursor": {"type": "string"}}}}}}
    },
    "schemas": {
      "CapacityPolicy": {"type": "object", "additionalProperties": false, "required": ["max_database_bytes", "min_free_bytes"], "properties": {"max_database_bytes": {"type": "integer", "minimum": 0, "maximum": 1125899906842624}, "min_free_bytes": {"type": "integer", "minimum": 0, "maximum": 1125899906842624}}},
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
      "Health": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}}},
      "Status": {"type": "object", "required": ["status", "last_ingested_at", "live_subscribers", "active_ingestions", "active_queries", "max_ingestions", "max_queries", "retention"], "properties": {"status": {"const": "ready"}, "last_ingested_at": {"type": ["string", "null"], "format": "date-time"}, "live_subscribers": {"type": "integer"}, "active_ingestions": {"type": "integer"}, "active_queries": {"type": "integer"}, "max_ingestions": {"type": "integer"}, "max_queries": {"type": "integer"}, "retention": {"description": "Most recent worker attempt for this deployment; null before a check, after restart or eviction. A full batch does not prove a backlog remains.", "oneOf": [{"type": "null"}, {"type": "object", "required": ["completed_at", "deleted", "batch_full", "failed"], "properties": {"completed_at": {"type": "string", "format": "date-time"}, "deleted": {"type": "integer", "minimum": 0}, "batch_full": {"type": "boolean"}, "failed": {"type": "boolean"}}}]}}},
      "Event": {"type": "object", "required": ["schema_version", "event_id", "time", "level", "instance_id", "app", "message"], "additionalProperties": false,
